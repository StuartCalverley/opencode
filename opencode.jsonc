{
  "$schema": "https://opencode.ai/config.json",
  "model": "nemotron-3-super",
  "autoupdate": true,
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
    },
	"composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    }
  },
  "plugin": [
    //"oh-my-openagent@latest",
    "@tarquinen/opencode-dcp@latest",
  ],
}
